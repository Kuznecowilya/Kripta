POSTGRES_USER=crypto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crypto_rates
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8081
KAFKA_TOPIC_RATES=crypto.rates.v1
# ---------- app: postgres ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ---------- app: kafka ----------
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=rates-consumer

# ---------- app: fetcher ----------
RATES_API_URL=https://api.coingecko.com/api/v3
FETCH_SYMBOLS=bitcoin,ethereum
FETCH_CURRENCY=usd
FETCH_INTERVAL=5m

# ---------- app: http ----------
HTTP_PORT=8080